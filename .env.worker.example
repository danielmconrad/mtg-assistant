# Secrets and overrides for the local Worker (`mise run dev` only). Copy to .env.worker, which Git
# ignores:
#
#   cp .env.worker.example .env.worker
#
# Keep this separate from .env. That file holds the Cloudflare and GitHub admin tokens for mise and
# setup:accounts; this one becomes the local Worker's environment, so it must never contain them.
# (wrangler's default name for this file is .dev.vars; the dev task points it here with --env-file.)

# Local dev serves plain http on loopback.
PUBLIC_ORIGIN=http://localhost:8787

# Who may sign in locally. Lowercase, comma-separated.
ALLOWED_EMAILS=

# Google OAuth client A (see .env.example section 3). Its redirect URIs must include
# http://localhost:8787/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# There's no Cloudflare Access locally, so this email stands in for the Access identity. The Worker
# honors it only when PUBLIC_ORIGIN and the request are both on loopback, and the email must also be in
# ALLOWED_EMAILS.
DEV_ACCESS_EMAIL=

# Signs collection download links (get_download_link). Any random value of 32 characters or more; make
# one with: openssl rand -base64 32
# In production setup:accounts generates this itself, so it never goes in .env.
DOWNLOAD_SIGNING_KEY=

# Signs upload page links (get_upload_link), made the same way as DOWNLOAD_SIGNING_KEY. setup:accounts
# generates the production one too.
UPLOAD_SIGNING_KEY=
