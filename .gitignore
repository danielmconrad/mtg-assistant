# Local secrets: only the documented example is committed
.env
.env.*
!.env.example
!.env.worker.example
# wrangler's default name for local secrets; this repo uses .env.worker, but keep strays out of Git.
.dev.vars*

# Tooling
node_modules/
.wrangler/
coverage/
mise.local.toml
.DS_Store
.tmp

# OpenTofu: providers, local state and plans never belong in Git (state lives encrypted in R2), and
# infra:adopt's ID list is for one machine's first apply.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/adopt.auto.tfvars.json
