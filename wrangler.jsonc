// Cloudflare Worker configuration. `mise run setup:accounts` fills in the resource IDs marked
// SETUP; until then local dev and tests use local simulations of each binding.
// tests/config.test.mjs pins the security-relevant settings below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtg-assistant",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",

  // The custom domain is the only way in: no *.workers.dev URL and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mtg-assistant.conrad.tools", "custom_domain": true }],

  // A backstop for runaway requests, such as an expensive regex search.
  "limits": { "cpu_ms": 10000 },
  "observability": { "enabled": true },

  "vars": {
    "PUBLIC_ORIGIN": "https://mtg-assistant.conrad.tools",
    // Hosts an OAuth client may send tokens to, besides loopback for Claude Code. claude.ai's
    // connector callback lives on these; refusals are logged as redirect_refused / registration_refused.
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com",
    "MAX_OAUTH_CLIENTS": "20",
    "ACCESS_TEAM_DOMAIN": "", // SETUP: <team>.cloudflareaccess.com
    "ACCESS_AUD": "", // SETUP: the Access application's audience tag
  },
  // Secrets (wrangler secret put, via setup:accounts): ALLOWED_EMAILS, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, and LOCKDOWN when the kill switch is on.

  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "SETUP" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "mtg-assistant", "database_id": "SETUP", "migrations_dir": "migrations" },
  ],

  // Per-IP limits on the auth endpoints and per-user limits on /mcp. Periods are 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_REGISTER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_MCP", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
  ],
}
