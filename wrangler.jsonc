// Cloudflare Worker configuration. `mise run setup:accounts` fills in the resource IDs marked
// SETUP; until then local dev and tests use local simulations of each binding.
// tests/config.test.mjs pins the security-relevant settings below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtg-assistant",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-01",

  // The custom domain is the only way in: no *.workers.dev URL and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mtg-assistant.conrad.tools", "custom_domain": true }],

  // A backstop for runaway requests, such as an expensive regex search.
  "limits": { "cpu_ms": 10000 },
  "observability": { "enabled": true },

  "vars": {
    "PUBLIC_ORIGIN": "https://mtg-assistant.conrad.tools",
    // Hosts an OAuth client may send tokens to, besides loopback for Claude Code. claude.ai's
    // connector callback lives on these; refusals are logged as redirect_refused / registration_refused.
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com",
    "OAUTH_CLIENT_ALERT_THRESHOLD": "20",
    "ACCESS_TEAM_DOMAIN": "conrad-tools.cloudflareaccess.com", // SETUP: <team>.cloudflareaccess.com
    "ACCESS_AUD": "4a902e2a79dcc7ac93d9546e59a1925e168a2f61c1446596cc3d4d3d4a31553c", // Access app audience tag: an identifier, not a secret (it's in every Access JWT). gitleaks:allow
  },
  // Secrets (wrangler secret put, via setup:accounts): ALLOWED_EMAILS, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET, DOWNLOAD_SIGNING_KEY, UPLOAD_SIGNING_KEY, and LOCKDOWN when the kill switch is on.

  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "c39481a75484458584704eb4f899350e" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtg-assistant",
      "database_id": "9b7b4a65-fe00-4883-bb08-3263fc15cd79",
      "migrations_dir": "migrations",
    },
  ],
  // Uploaded collection files, kept as uploaded. Private: no public access and no r2.dev URL
  // (setup:accounts creates the bucket and turns the r2.dev URL off).
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "mtg-assistant-uploads" }],

  // Per-IP limits on the auth endpoints, downloads and uploads, and per-user limits on /mcp. Periods are 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_REGISTER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_MCP", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_DOWNLOAD", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    // EDHREC asks for about one request a second: shared by everyone, not per IP.
    { "name": "RL_EDHREC", "namespace_id": "1007", "simple": { "limit": 10, "period": 10 } },
  ],
}
